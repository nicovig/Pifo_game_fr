---
import Layout from '../layouts/Layout.astro';
import rawCities from '../datas/cities.json';

type CityRaw = {
	'Ville': string;
	'Commune officielle': string;
	'Code INSEE': string;
	'N° Département': string;
	'Département': string;
	'Population': string;
	'Latitude': string;
	'Longitude': string;
	'Célébrité': string;
	'Date de naissance': string;
	'Pluviométrie 2024 (mm)': string;
	'Prix m² (€)': string;
};

type City = {
	id: string;
	name: string;
	officialName: string;
	inseeCode: string;
	departmentNumber: number;
	departmentName: string;
	population: number;
	latitude: number;
	longitude: number;
	celebrity: string;
	birthDate: string;
	birthTimestamp: number;
	rainfallMm: number;
	pricePerSquareMeter: number;
};

const parseFrenchNumber = (value: string) => Number.parseFloat(value.replace(',', '.'));

const parseBirthTimestamp = (value: string) => {
	const [day, month, year] = value.split('/').map((part) => Number.parseInt(part, 10));
	if (!day || !month || !year) {
		return Number.NaN;
	}
	return Date.UTC(year, month - 1, day);
};

const cities: City[] = (rawCities as CityRaw[]).map((city) => ({
	id: city['Code INSEE'],
	name: city['Ville'],
	officialName: city['Commune officielle'],
	inseeCode: city['Code INSEE'],
	departmentNumber: Number.parseInt(city['N° Département'], 10),
	departmentName: city['Département'],
	population: Number.parseInt(city['Population'], 10),
	latitude: parseFrenchNumber(city['Latitude']),
	longitude: parseFrenchNumber(city['Longitude']),
	celebrity: city['Célébrité'],
	birthDate: city['Date de naissance'],
	birthTimestamp: parseBirthTimestamp(city['Date de naissance']),
	rainfallMm: parseFrenchNumber(city['Pluviométrie 2024 (mm)']),
	pricePerSquareMeter: Number.parseInt(city['Prix m² (€)'], 10)
}));
---

<Layout pageTitle="PIFO France - Classement des villes">
	<main class="app">
		<section class="left-panel">
			<div class="card hero-card">
				<h1>PIFO France</h1>
				<p class="subtitle">Trie les villes, constitue une selection et compare tes choix sur la carte.</p>
			</div>

			<div class="card controls-card">
				<div class="controls-grid">
					<div class="control-group">
						<label for="sort-criterion">Critere</label>
						<select id="sort-criterion">
							<option value="departmentNumber">Numero de departement</option>
							<option value="population">Population</option>
							<option value="latitude">Latitude</option>
							<option value="longitude">Longitude</option>
							<option value="birthTimestamp">Date de naissance de la celebrite</option>
							<option value="rainfallMm">Pluviometrie (mm)</option>
							<option value="pricePerSquareMeter">Prix au m2 (EUR)</option>
						</select>
					</div>

					<div class="control-group">
						<label for="sort-order">Ordre</label>
						<select id="sort-order">
							<option value="desc">Du plus au moins</option>
							<option value="asc">Du moins au plus</option>
						</select>
					</div>

					<div class="control-group">
						<label for="scope-mode">Mode d'affichage</label>
						<select id="scope-mode">
							<option value="all">Toutes les villes</option>
							<option value="selected">Villes selectionnees</option>
						</select>
					</div>
				</div>
				<div class="actions-row">
					<button id="clear-selection" class="action-button tertiary" type="button">Vider la selection</button>
					<button id="fit-selection" class="action-button" type="button">Cadrer la selection</button>
				</div>
			</div>

			<div class="card list-card">
				<div class="list-header">
					<p id="result-count" class="result-count"></p>
					<p id="selection-count" class="selection-count"></p>
				</div>
				<ul id="city-list" class="city-list"></ul>
			</div>
		</section>

		<section class="right-panel">
			<div id="map"></div>
			<aside class="map-overlay">
				<div class="card overlay-card compact">
					<div class="overlay-title-row">
						<h2>Selection</h2>
						<div class="legend-inline">
							<span class="legend-item"><span class="dot dot-default"></span>Normale</span>
							<span class="legend-item"><span class="dot dot-selected"></span>Selectionnee</span>
						</div>
					</div>
					<p>Clique sur une tuile a gauche ou un marqueur sur la carte pour ajouter/enlever une ville.</p>
				</div>
			</aside>
		</section>
	</main>

	<script id="cities-data" type="application/json" set:html={JSON.stringify(cities)}></script>
	<script>
		import L from 'leaflet';
		import 'leaflet/dist/leaflet.css';

		const cityDataElement = document.getElementById('cities-data');
		const criterionElement = document.getElementById('sort-criterion');
		const orderElement = document.getElementById('sort-order');
		const scopeElement = document.getElementById('scope-mode');
		const cityListElement = document.getElementById('city-list');
		const resultCountElement = document.getElementById('result-count');
		const selectionCountElement = document.getElementById('selection-count');
		const clearSelectionButton = document.getElementById('clear-selection');
		const fitSelectionButton = document.getElementById('fit-selection');
		const cities = JSON.parse(cityDataElement?.textContent ?? '[]');
		const map = L.map('map', { zoomControl: true, worldCopyJump: true });
		const selectedCityIds = new Set();

		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; OpenStreetMap contributors'
		}).addTo(map);

		const markersById = new Map();
		const markerGroup = L.featureGroup();

		const getMarkerStyle = (isSelected) =>
			isSelected
				? {
						radius: 7,
						color: '#5f0f40',
						weight: 2,
						fillColor: '#e76f51',
						fillOpacity: 0.95
					}
				: {
						radius: 6,
						color: '#1f4f77',
						weight: 1,
						fillColor: '#3f88c5',
						fillOpacity: 0.85
					};

		cities.forEach((city) => {
			const marker = L.circleMarker([city.latitude, city.longitude], getMarkerStyle(false));
			marker.bindPopup(
				`<strong>${city.name}</strong><br>${city.departmentName} (${city.departmentNumber})<br>Population: ${city.population.toLocaleString(
					'fr-FR'
				)}`
			);
			marker.on('click', () => {
				toggleSelection(city.id);
				render();
			});
			marker.addTo(markerGroup);
			markersById.set(city.id, marker);
		});

		markerGroup.addTo(map);

		const bounds = markerGroup.getBounds();
		if (bounds.isValid()) {
			map.fitBounds(bounds, { padding: [30, 30] });
		} else {
			map.setView([46.6, 2.2], 5);
		}

		const formatNumber = (value) => value.toLocaleString('fr-FR');

		const updateMarkerStyles = () => {
			cities.forEach((city) => {
				const marker = markersById.get(city.id);
				if (!marker) return;
				marker.setStyle(getMarkerStyle(selectedCityIds.has(city.id)));
			});
		};

		const toggleSelection = (cityId) => {
			if (selectedCityIds.has(cityId)) {
				selectedCityIds.delete(cityId);
			} else {
				selectedCityIds.add(cityId);
			}
			updateMarkerStyles();
		};

		const getCitiesToDisplay = () => {
			const scope = scopeElement?.value ?? 'all';
			if (scope === 'selected') {
				return cities.filter((city) => selectedCityIds.has(city.id));
			}
			return cities;
		};

		const focusSelection = () => {
			const selectionMarkers = [...selectedCityIds]
				.map((cityId) => markersById.get(cityId))
				.filter(Boolean);
			if (selectionMarkers.length === 0) {
				return;
			}
			const group = L.featureGroup(selectionMarkers);
			const selectionBounds = group.getBounds();
			if (selectionBounds.isValid()) {
				map.fitBounds(selectionBounds, { padding: [30, 30] });
			}
		};

		const render = () => {
			const criterion = criterionElement?.value ?? 'population';
			const order = orderElement?.value ?? 'desc';
			const direction = order === 'asc' ? 1 : -1;
			const sourceCities = getCitiesToDisplay();

			const sortedCities = [...sourceCities].sort((a, b) => {
				const first = a[criterion];
				const second = b[criterion];
				if (first > second) return direction;
				if (first < second) return -direction;
				return a.name.localeCompare(b.name, 'fr');
			});

			if (resultCountElement) {
				resultCountElement.textContent = `${sortedCities.length} villes affichees`;
			}
			if (selectionCountElement) {
				selectionCountElement.textContent = `${selectedCityIds.size} villes selectionnees`;
			}

			if (!cityListElement) return;
			cityListElement.innerHTML = '';
			const fragment = document.createDocumentFragment();

			sortedCities.forEach((city, index) => {
				const item = document.createElement('li');
				item.className = 'city-item';
				if (selectedCityIds.has(city.id)) {
					item.classList.add('is-selected');
				}
				item.dataset.cityId = city.id;

				const rank = document.createElement('span');
				rank.className = 'rank';
				rank.textContent = String(index + 1);

				const content = document.createElement('div');
				content.className = 'city-content';

				const title = document.createElement('strong');
				title.textContent = city.name;

				const details = document.createElement('span');
				details.className = 'city-details';
				details.innerHTML = `
					<br>
					<span class="detail-line"><span class="detail-label">Departement </span><span class="detail-value">${city.departmentName} (${city.departmentNumber})</span></span>
					<br>
					<span class="detail-line"><span class="detail-label">Population </span><span class="detail-value">${formatNumber(city.population)}</span></span>
					<br>
					<span class="detail-line"><span class="detail-label">Pluviometrie </span><span class="detail-value">${city.rainfallMm} mm</span></span>
					<br>
					<span class="detail-line"><span class="detail-label">Prix m2 </span><span class="detail-value">${city.pricePerSquareMeter} EUR/m2</span></span>
				`;

				const selectionToggle = document.createElement('button');
				selectionToggle.type = 'button';
				selectionToggle.className = 'select-button';
				selectionToggle.textContent = selectedCityIds.has(city.id) ? 'Retirer' : 'Selectionner';
				selectionToggle.addEventListener('click', (event) => {
					event.stopPropagation();
					toggleSelection(city.id);
					render();
				});

				content.append(title, details);
				item.append(rank, content, selectionToggle);

				item.addEventListener('click', () => {
					toggleSelection(city.id);
					render();
					const marker = markersById.get(city.id);
					if (!marker) return;
					map.flyTo(marker.getLatLng(), Math.max(map.getZoom(), 7), { duration: 0.6 });
					marker.openPopup();
				});

				fragment.appendChild(item);
			});

			cityListElement.appendChild(fragment);
		};

		criterionElement?.addEventListener('change', render);
		orderElement?.addEventListener('change', render);
		scopeElement?.addEventListener('change', render);
		clearSelectionButton?.addEventListener('click', () => {
			selectedCityIds.clear();
			updateMarkerStyles();
			render();
		});
		fitSelectionButton?.addEventListener('click', focusSelection);
		render();
	</script>
</Layout>

<style>
	:root {
		--pifo-blue: #1f4f77;
		--pifo-blue-soft: #3f88c5;
		--pifo-cream: #f7efe0;
		--pifo-red: #e76f51;
		--pifo-deep: #5f0f40;
		--pifo-ink: #1d2430;
	}

	:global(html),
	:global(body) {
		background: linear-gradient(160deg, #ebe3d6 0%, #f7efe0 100%);
		color: var(--pifo-ink);
		font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	}

	.app {
		display: grid;
		grid-template-columns: minmax(360px, 40%) 1fr;
		min-height: 100vh;
		height: auto;
		gap: 1rem;
		padding: 1rem;
		box-sizing: border-box;
	}

	.left-panel {
		display: flex;
		flex-direction: column;
		overflow: visible;
		gap: 1rem;
	}

	.card {
		border-radius: 16px;
		background: #fff;
		border: 2px solid rgba(31, 79, 119, 0.2);
		box-shadow: 0 8px 22px rgba(31, 79, 119, 0.12);
		padding: 1rem 1.1rem;
	}

	.hero-card {
		background: linear-gradient(130deg, #ffffff 15%, #f2f8ff 100%);
	}

	h1,
	h2 {
		margin: 0;
		color: var(--pifo-blue);
	}

	h1 {
		font-size: 2rem;
	}

	.subtitle {
		margin: 0.6rem 0 0;
		color: #2e4052;
		font-size: 1rem;
		line-height: 1.4;
	}

	.controls-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
	}

	.control-group {
		display: grid;
		gap: 0.4rem;
	}

	label {
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--pifo-blue);
	}

	select {
		border: 1px solid #b9cddd;
		border-radius: 12px;
		padding: 0.68rem 0.75rem;
		font-size: 1rem;
		background: #fff;
		color: #102a43;
	}

	.actions-row {
		display: flex;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.action-button {
		border: none;
		border-radius: 10px;
		padding: 0.58rem 0.8rem;
		cursor: pointer;
		background: var(--pifo-blue);
		color: #fff;
		font-weight: 700;
	}

	.action-button.tertiary {
		background: #ddeaf7;
		color: #1d3f5e;
	}

	.list-card {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		min-height: 0;
	}

	.list-header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.7rem;
	}

	.result-count {
		font-size: 0.95rem;
		color: #2e4052;
		margin: 0;
		font-weight: 600;
	}

	.selection-count {
		font-size: 0.9rem;
		margin: 0;
		color: var(--pifo-deep);
		font-weight: 700;
	}

	:global(.city-list) {
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-y: auto;
		display: grid;
		gap: 0.7rem;
		padding-right: 0.25rem;
	}

	:global(.city-item) {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		border: 1px solid rgba(31, 79, 119, 0.2);
		border-radius: 12px;
		padding: 0.8rem 0.85rem;
		cursor: pointer;
		background: linear-gradient(145deg, #ffffff 0%, #f8fbff 100%);
	}

	:global(.city-item:hover) {
		border-color: var(--pifo-blue-soft);
		background: #f4f9ff;
	}

	:global(.city-item.is-selected) {
		border-color: var(--pifo-red);
		background: #fff6f2;
	}

	:global(.rank) {
		min-width: 28px;
		height: 28px;
		border-radius: 999px;
		background: #dce9f7;
		color: var(--pifo-blue);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.85rem;
	}

	:global(.city-content) {
		display: grid;
		gap: 0.2rem;
		flex: 1;
	}

	:global(.city-content strong) {
		font-size: 1.05rem;
		color: #132a42;
		letter-spacing: 0.2px;
	}

	:global(.city-details) {
		color: #334e68;
		font-size: 0.9rem;
		line-height: 1.3;
		display: grid;
		gap: 0.26rem;
		margin-top: 0.15rem;
	}

	:global(.detail-line) {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	:global(.detail-label) {
		display: inline-flex;
		background: #e8f1fb;
		color: #1f4f77;
		border-radius: 999px;
		padding: 0.12rem 0.45rem;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.3px;
	}

	:global(.detail-value) {
		color: #1d3557;
		font-weight: 500;
	}

	:global(.select-button) {
		border: none;
		border-radius: 8px;
		background: #e6f2ff;
		color: var(--pifo-blue);
		padding: 0.45rem 0.65rem;
		font-size: 0.8rem;
		font-weight: 700;
		cursor: pointer;
	}

	:global(.city-item.is-selected .select-button) {
		background: #ffe2d9;
		color: #7f2d1e;
	}

	.right-panel {
		min-height: 100vh;
		position: relative;
		overflow: hidden;
		border-radius: 18px;
		border: 2px solid rgba(31, 79, 119, 0.22);
		box-shadow: 0 8px 22px rgba(31, 79, 119, 0.12);
	}

	#map {
		width: 100%;
		height: 100%;
	}

	.map-overlay {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: grid;
		gap: 0.5rem;
		max-width: min(340px, 90%);
		z-index: 500;
	}

	.overlay-card {
		padding: 0.75rem 0.85rem;
		background: rgba(255, 255, 255, 0.93);
		backdrop-filter: blur(5px);
	}

	.overlay-card h2 {
		font-size: 1rem;
		margin-bottom: 0.2rem;
	}

	.overlay-card.compact {
		padding: 0.6rem 0.75rem;
	}

	.overlay-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.legend-inline {
		display: inline-flex;
		gap: 0.55rem;
		flex-wrap: wrap;
	}

	.overlay-card p {
		margin: 0;
		font-size: 0.82rem;
		color: #2f4858;
		line-height: 1.3;
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem;
		color: #102a43;
	}

	.dot {
		width: 11px;
		height: 11px;
		border-radius: 999px;
		display: inline-flex;
	}

	.dot-default {
		background: var(--pifo-blue-soft);
	}

	.dot-selected {
		background: var(--pifo-red);
	}

	@media (max-width: 1080px) {
		.app {
			grid-template-columns: 1fr;
			grid-template-rows: 56vh 44vh;
			height: auto;
		}

		.left-panel {
			min-height: 0;
		}

		.right-panel {
			min-height: 0;
			height: 64vh;
		}
	}
</style>
