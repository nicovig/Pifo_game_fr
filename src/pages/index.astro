---
import Layout from '../layouts/Layout.astro';
import rawCities from '../datas/cities.json';

type CityRaw = {
	'Ville': string;
	'Commune officielle': string;
	'Code INSEE': string;
	'N° Département': string;
	'Département': string;
	'Population': string;
	'Latitude': string;
	'Longitude': string;
	'Célébrité': string;
	'Date de naissance': string;
	'Pluviométrie 2024 (mm)': string;
	'Prix m² (€)': string;
};

type City = {
	id: string;
	name: string;
	officialName: string;
	inseeCode: string;
	departmentNumber: number;
	departmentName: string;
	population: number;
	latitude: number;
	longitude: number;
	celebrity: string;
	birthDate: string;
	birthTimestamp: number;
	rainfallMm: number;
	pricePerSquareMeter: number;
};

const parseFrenchNumber = (value: string) => Number.parseFloat(value.replace(',', '.'));

const parseBirthTimestamp = (value: string) => {
	const [day, month, year] = value.split('/').map((part) => Number.parseInt(part, 10));
	if (!day || !month || !year) {
		return Number.NaN;
	}
	return Date.UTC(year, month - 1, day);
};

const cities: City[] = (rawCities as CityRaw[]).map((city) => ({
	id: city['Code INSEE'],
	name: city['Ville'],
	officialName: city['Commune officielle'],
	inseeCode: city['Code INSEE'],
	departmentNumber: Number.parseInt(city['N° Département'], 10),
	departmentName: city['Département'],
	population: Number.parseInt(city['Population'], 10),
	latitude: parseFrenchNumber(city['Latitude']),
	longitude: parseFrenchNumber(city['Longitude']),
	celebrity: city['Célébrité'],
	birthDate: city['Date de naissance'],
	birthTimestamp: parseBirthTimestamp(city['Date de naissance']),
	rainfallMm: parseFrenchNumber(city['Pluviométrie 2024 (mm)']),
	pricePerSquareMeter: Number.parseInt(city['Prix m² (€)'], 10)
}));
---

<Layout pageTitle="PIFO France - Classement des villes">
	<main class="app">
		<h1 class="site-title">PIFO <span class="site-title-badge">FRANCE</span></h1>
		<section class="right-panel">
			<div id="map"></div>
		</section>

		<section class="filters-panel">

			<div class="card controls-card">
				<div class="controls-grid">
					<div class="control-group search-group">
						<div class="search-label-row">
							<label for="search-query">Rechercher la ville ou le département</label>
							<button id="sources-info-button" class="info-bubble" type="button" aria-label="Afficher les sources">
								i
							</button>
						</div>
						<input id="search-query" type="text" placeholder="Ex: Nantes, Martinique, 972" />
					</div>

					<div class="control-inline">
						<div class="control-group">
							<label for="sort-criterion">Critère de tri</label>
							<select id="sort-criterion">
								<option value="name">Alphabétique</option>
								<option value="departmentNumber" selected>Département</option>
								<option value="population">Population</option>
								<option value="latitude">Latitude</option>
								<option value="longitude">Longitude</option>
								<option value="birthTimestamp">Naissance célébrité</option>
								<option value="rainfallMm">Pluviométrie</option>
								<option value="pricePerSquareMeter">Prix m2</option>
							</select>
						</div>

						<div class="control-group">
							<label for="sort-order">Trier du</label>
							<select id="sort-order">
								<option value="asc" selected>Moins au plus</option>
								<option value="desc">Plus au moins</option>
							</select>
						</div>
					</div>

					<div class="control-group">
						<label for="scope-mode">Villes à afficher</label>
						<select id="scope-mode">
							<option value="all">Toutes les villes</option>
							<option value="selected">Villes sélectionnées</option>
						</select>
					</div>
				</div>
				<div class="actions-row">
					<button id="clear-selection" class="action-button tertiary" type="button">Vider la sélection</button>
					<button id="fit-selection" class="action-button" type="button">Cadrer sur la carte</button>
				</div>
			</div>

			<div id="sources-modal" class="sources-modal" hidden>
				<div class="sources-modal-card">
					<h2>Sources des données</h2>
					<ul class="sources-list">
						<li>Immobilier: données 04/2026 (DVF)</li>
						<li>Pluviométrie: données 2025 (Météo France)</li>
						<li>Population: données 2024 (INSEE)</li>
					</ul>
					<button id="sources-close-button" class="action-button" type="button">Fermer</button>
				</div>
			</div>
		</section>

		<section class="list-panel">
			<div class="card list-card">
				<div class="list-header">
					<p id="result-count" class="result-count"></p>
					<p id="selection-count" class="selection-count"></p>
				</div>
				<ul id="city-list" class="city-list"></ul>
				<p class="list-disclaimer">
					Application indépendante, non affiliée à Génépi Éditions.
				</p>
			</div>
		</section>
	</main>

	<script id="cities-data" type="application/json" set:html={JSON.stringify(cities)}></script>
	<script>
		import L from 'leaflet';
		import 'leaflet/dist/leaflet.css';

		const cityDataElement = document.getElementById('cities-data');
		const criterionElement = document.getElementById('sort-criterion');
		const orderElement = document.getElementById('sort-order');
		const scopeElement = document.getElementById('scope-mode');
		const searchElement = document.getElementById('search-query');
		const cityListElement = document.getElementById('city-list');
		const mapSectionElement = document.querySelector('.right-panel');
		const resultCountElement = document.getElementById('result-count');
		const selectionCountElement = document.getElementById('selection-count');
		const clearSelectionButton = document.getElementById('clear-selection');
		const fitSelectionButton = document.getElementById('fit-selection');
		const sourcesInfoButton = document.getElementById('sources-info-button');
		const sourcesCloseButton = document.getElementById('sources-close-button');
		const sourcesModal = document.getElementById('sources-modal');
		const cities = JSON.parse(cityDataElement?.textContent ?? '[]');
		const map = L.map('map', { zoomControl: true, worldCopyJump: true });
		const selectedCityIds = new Set();

		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; OpenStreetMap contributors'
		}).addTo(map);

		const markersById = new Map();
		const markerGroup = L.featureGroup();

		const getMarkerStyle = (isSelected) =>
			isSelected
				? {
						radius: 7,
						color: '#5f0f40',
						weight: 2,
						fillColor: '#e76f51',
						fillOpacity: 0.95
					}
				: {
						radius: 6,
						color: '#1f4f77',
						weight: 1,
						fillColor: '#3f88c5',
						fillOpacity: 0.85
					};

		cities.forEach((city) => {
			const marker = L.circleMarker([city.latitude, city.longitude], getMarkerStyle(false));
			marker.bindPopup(
				`<strong>${city.name}</strong><br>${city.departmentName} (${city.departmentNumber})<br>Population: ${city.population.toLocaleString(
					'fr-FR'
				)}`
			);
			marker.on('click', () => {
				toggleSelection(city.id);
				render();
			});
			marker.addTo(markerGroup);
			markersById.set(city.id, marker);
		});

		markerGroup.addTo(map);

		const bounds = markerGroup.getBounds();
		if (bounds.isValid()) {
			map.fitBounds(bounds, { padding: [30, 30] });
		} else {
			map.setView([46.6, 2.2], 5);
		}

		const formatNumber = (value) => value.toLocaleString('fr-FR');

		const updateMarkerStyles = () => {
			cities.forEach((city) => {
				const marker = markersById.get(city.id);
				if (!marker) return;
				marker.setStyle(getMarkerStyle(selectedCityIds.has(city.id)));
			});
		};

		const toggleSelection = (cityId) => {
			if (selectedCityIds.has(cityId)) {
				selectedCityIds.delete(cityId);
			} else {
				selectedCityIds.add(cityId);
			}
			updateMarkerStyles();
		};

		const normalizeText = (value) =>
			value
				.toLowerCase()
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.trim();

		const getCitiesToDisplay = () => {
			const scope = scopeElement?.value ?? 'all';
			const query = normalizeText(searchElement?.value ?? '');
			const scopedCities =
				scope === 'selected' ? cities.filter((city) => selectedCityIds.has(city.id)) : cities;
			if (!query) {
				return scopedCities;
			}
			return scopedCities.filter((city) => {
				const cityName = normalizeText(city.name);
				const departmentName = normalizeText(city.departmentName);
				const departmentCode = String(city.departmentNumber);
				return (
					cityName.includes(query) ||
					departmentName.includes(query) ||
					departmentCode.includes(query)
				);
			});
		};

		const focusSelection = () => {
			const selectionMarkers = [...selectedCityIds]
				.map((cityId) => markersById.get(cityId))
				.filter(Boolean);
			if (selectionMarkers.length === 0) {
				return;
			}
			const group = L.featureGroup(selectionMarkers);
			const selectionBounds = group.getBounds();
			if (selectionBounds.isValid()) {
				map.fitBounds(selectionBounds, { padding: [30, 30] });
			}
		};

		const createDetailLine = (labelText, valueText) => {
			const detailLine = document.createElement('span');
			detailLine.className = 'detail-line';
			const label = document.createElement('span');
			label.className = 'detail-label';
			label.textContent = labelText;
			const value = document.createElement('span');
			value.className = 'detail-value';
			value.textContent = valueText;
			detailLine.append(label, value);
			return detailLine;
		};

		const render = () => {
			const criterion = criterionElement?.value ?? 'departmentNumber';
			const order = orderElement?.value ?? 'asc';
			const direction = order === 'asc' ? 1 : -1;
			const sourceCities = getCitiesToDisplay();

			const sortedCities = [...sourceCities].sort((a, b) => {
				if (criterion === 'name') {
					return a.name.localeCompare(b.name, 'fr', { sensitivity: 'base' }) * direction;
				}
				const first = a[criterion];
				const second = b[criterion];
				if (first > second) return direction;
				if (first < second) return -direction;
				return a.name.localeCompare(b.name, 'fr');
			});

			if (resultCountElement) {
				resultCountElement.textContent = `${sortedCities.length} villes affichées`;
			}
			if (selectionCountElement) {
				selectionCountElement.textContent = `${selectedCityIds.size} villes sélectionnées`;
			}

			if (!cityListElement) return;
			cityListElement.innerHTML = '';
			const fragment = document.createDocumentFragment();

			sortedCities.forEach((city, index) => {
				const item = document.createElement('li');
				item.className = 'city-item';
				if (selectedCityIds.has(city.id)) {
					item.classList.add('is-selected');
				}
				item.dataset.cityId = city.id;

				const rank = document.createElement('button');
				rank.type = 'button';
				rank.className = 'rank';
				rank.textContent = String(index + 1);
				rank.addEventListener('click', (event) => {
					event.stopPropagation();
					toggleSelection(city.id);
					render();
				});

				const content = document.createElement('div');
				content.className = 'city-content';

				const topRow = document.createElement('div');
				topRow.className = 'city-top-row';

				const title = document.createElement('span');
				title.className = 'city-title';
				title.textContent = city.name;
				topRow.append(title);

				const selectionToggle = document.createElement('button');
				selectionToggle.type = 'button';
				selectionToggle.className = 'select-button';
				selectionToggle.textContent = selectedCityIds.has(city.id) ? 'Retirer' : 'Sélectionner';
				selectionToggle.addEventListener('click', (event) => {
					event.stopPropagation();
					toggleSelection(city.id);
					render();
				});

				const details = document.createElement('div');
				details.className = 'city-details';
				details.append(
					createDetailLine('Département', `${city.departmentName} (${city.departmentNumber})`),
					createDetailLine('Population', formatNumber(city.population)),
					createDetailLine('Célébrité ', city.celebrity),
					createDetailLine('Naissance', city.birthDate),
					createDetailLine('Pluviométrie', `${city.rainfallMm} mm`),
					createDetailLine('Prix m2', `${city.pricePerSquareMeter} EUR/m2`)				
				);


				const actions = document.createElement('div');
				actions.className = 'city-actions';
				actions.append(selectionToggle);

				content.append(topRow, details, actions);
				item.append(rank, content);

				item.addEventListener('click', () => {
					toggleSelection(city.id);
					render();
					mapSectionElement?.scrollIntoView({ behavior: 'smooth', block: 'start' });
					const marker = markersById.get(city.id);
					if (!marker) return;
					map.flyTo(marker.getLatLng(), Math.max(map.getZoom(), 7), { duration: 0.6 });
					marker.openPopup();
				});

				fragment.appendChild(item);
			});

			cityListElement.appendChild(fragment);
		};

		criterionElement?.addEventListener('change', render);
		orderElement?.addEventListener('change', render);
		scopeElement?.addEventListener('change', render);
		searchElement?.addEventListener('input', render);
		sourcesInfoButton?.addEventListener('click', () => {
			sourcesModal?.removeAttribute('hidden');
		});
		sourcesCloseButton?.addEventListener('click', () => {
			sourcesModal?.setAttribute('hidden', '');
		});
		sourcesModal?.addEventListener('click', (event) => {
			if (event.target === sourcesModal) {
				sourcesModal.setAttribute('hidden', '');
			}
		});
		clearSelectionButton?.addEventListener('click', () => {
			selectedCityIds.clear();
			updateMarkerStyles();
			render();
		});
		fitSelectionButton?.addEventListener('click', focusSelection);
		render();
	</script>
</Layout>

<style>
	:root {
		--pifo-blue: #1f4f77;
		--pifo-blue-soft: #3f88c5;
		--pifo-cream: #f7efe0;
		--pifo-red: #e76f51;
		--pifo-deep: #5f0f40;
		--pifo-ink: #1d2430;
	}

	:global(html),
	:global(body) {
		background: #ffffff;
		color: var(--pifo-ink);
		font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	}

	.app {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		height: auto;
		gap: 0.7rem;
		padding: 0.65rem;
		box-sizing: border-box;
	}

	.site-title {
		margin: 0;
		text-align: center;
		font-size: 1.3rem;
		font-weight: 900;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: #1a4f86;
		font-family: Impact, Haettenschweiler, 'Arial Black', sans-serif;
	}

	.site-title-badge {
		display: inline-block;
		margin-left: 0.25rem;
		padding: 0.02rem 0.35rem;
		border-radius: 7px;
		background: #e23b4a;
		color: #ffffff;
		font-size: 0.68em;
		letter-spacing: 0.5px;
	}

	.filters-panel {
		display: flex;
		flex-direction: column;
		overflow: visible;
		gap: 0.6rem;
	}

	.card {
		border-radius: 16px;
		background: #eef6ff;
		border: 2px solid rgba(31, 79, 119, 0.2);
		box-shadow: 0 8px 22px rgba(31, 79, 119, 0.12);
		padding: 0.72rem 0.8rem;
	}

	.hero-card {
		background: linear-gradient(130deg, #f4f9ff 15%, #e8f3ff 100%);
	}

	.compact-hero {
		padding-block: 0.48rem;
	}

	h1,
	h2 {
		margin: 0;
		color: var(--pifo-blue);
	}

	h1 {
		font-size: 1.34rem;
	}

	.controls-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
	}

	.control-group {
		display: grid;
		gap: 0.25rem;
	}

	.control-inline {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.45rem;
	}

	label {
		font-weight: 600;
		font-size: 0.76rem;
		color: var(--pifo-blue);
		letter-spacing: 0.2px;
	}

	input,
	select {
		border: 1px solid #b9cddd;
		border-radius: 10px;
		padding: 0.46rem 0.52rem;
		font-size: 0.87rem;
		background: #fff;
		color: #102a43;
	}

	.search-group {
		margin-bottom: 0.15rem;
	}

	.search-label-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.45rem;
	}

	.info-bubble {
		border: none;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 999px;
		background: #1f4f77;
		color: #ffffff;
		font-size: 0.78rem;
		font-weight: 700;
		cursor: pointer;
		line-height: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.actions-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.55rem;
	}

	.action-button {
		border: none;
		border-radius: 10px;
		padding: 0.44rem 0.58rem;
		cursor: pointer;
		background: var(--pifo-blue);
		color: #fff;
		font-weight: 700;
		font-size: 0.78rem;
	}

	.action-button.tertiary {
		background: #ddeaf7;
		color: #1d3f5e;
	}

	.sources-modal {
		position: fixed;
		inset: 0;
		background: rgba(7, 20, 36, 0.45);
		display: grid;
		place-items: center;
		padding: 1rem;
		z-index: 2000;
	}

	.sources-modal[hidden] {
		display: none;
	}

	.sources-modal-card {
		width: min(92vw, 320px);
		background: #ffffff;
		border-radius: 14px;
		padding: 0.9rem;
		border: 2px solid #b9cddd;
		display: grid;
		gap: 0.6rem;
	}

	.sources-modal-card h2 {
		font-size: 0.95rem;
		margin: 0;
	}

	.sources-list {
		margin: 0;
		padding-left: 1rem;
		display: grid;
		gap: 0.25rem;
		font-size: 0.85rem;
		color: #1d3557;
	}

	.list-card {
		display: block;
	}

	.list-disclaimer {
		margin: 0.75rem 0 0;
		font-size: 0.68rem;
		font-style: italic;
		color: #64748b;
		text-align: center;
		line-height: 1.35;
	}

	.list-header {
		display: flex;
		justify-content: space-between;
		gap: 0.4rem;
		margin-bottom: 0.5rem;
	}

	.result-count {
		font-size: 0.83rem;
		color: #2e4052;
		margin: 0;
		font-weight: 600;
	}

	.selection-count {
		font-size: 0.8rem;
		margin: 0;
		color: var(--pifo-deep);
		font-weight: 700;
	}

	:global(.city-list) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		max-height: none;
	}

	:global(.city-item) {
		display: flex;
		align-items: stretch;
		gap: 0.65rem;
		border: 1px solid rgba(31, 79, 119, 0.2);
		border-radius: 12px;
		padding: 0.62rem 0.68rem;
		cursor: pointer;
		background: linear-gradient(145deg, #ffffff 0%, #f8fbff 100%);
	}

	:global(.city-item:hover) {
		border-color: var(--pifo-blue-soft);
		background: #f4f9ff;
	}

	:global(.city-item.is-selected) {
		border-color: var(--pifo-red);
		background: #fff6f2;
	}

	:global(.rank) {
		border: none;
		min-width: 28px;
		height: 28px;
		border-radius: 999px;
		background: #dce9f7;
		color: var(--pifo-blue);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.85rem;
		cursor: pointer;
	}

	:global(.city-content) {
		display: grid;
		gap: 0.35rem;
		flex: 1;
	}

	:global(.city-top-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.55rem;
	}

	:global(.city-title) {
		text-align: left;
		font-size: 0.9rem;
		color: #132a42;
		letter-spacing: 0.2px;
		font-weight: 700;
	}

	:global(.city-details) {
		color: #334e68;
		font-size: 0.82rem;
		line-height: 1.3;
		display: grid;
		gap: 0.26rem;
		margin-top: 0.15rem;
	}

	:global(.city-actions) {
		display: flex;
		justify-content: flex-end;
	}

	:global(.detail-line) {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	:global(.detail-label) {
		display: inline-flex;
		background: #e8f1fb;
		color: #1f4f77;
		border-radius: 999px;
		padding: 0.12rem 0.45rem;
		font-size: 0.66rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.3px;
	}

	:global(.detail-value) {
		color: #1d3557;
		font-weight: 500;
	}

	:global(.select-button) {
		border: none;
		border-radius: 8px;
		background: #e6f2ff;
		color: var(--pifo-blue);
		padding: 0.34rem 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		cursor: pointer;
	}

	:global(.city-item.is-selected .select-button) {
		background: #ffe2d9;
		color: #7f2d1e;
	}

	.right-panel {
		min-height: 39vh;
		height: 39vh;
		position: relative;
		overflow: hidden;
		border-radius: 18px;
		border: 2px solid rgba(31, 79, 119, 0.22);
		box-shadow: 0 8px 22px rgba(31, 79, 119, 0.12);
